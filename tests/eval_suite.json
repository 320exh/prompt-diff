{
  "name": "agent_v2 regression suite",
  "cases": [
    {
      "id": "refund-request",
      "input": "I was charged twice this month and want a refund.",
      "expect": {
        "classification": { "$in": ["refund", "billing"] },
        "confidence": { "$gte": 0.5 }
      }
    },
    {
      "id": "password-reset",
      "input": "How do I reset my account password?",
      "expect": {
        "classification": { "$in": ["account", "support"] },
        "confidence": { "$gte": 0.5 }
      }
    },
    {
      "id": "empty-query",
      "input": "",
      "expect": {
        "classification": { "$in": ["unspecified", "unknown"] },
        "confidence": { "$lte": 0.5 }
      }
    }
  ]
}